# Dependencies and build output
node_modules/
dist/
coverage/

# Per-category splits of the seed bank (generated by web/scripts/split-bank.ts)
web/src/content/banks/
web/src/content/bank-index.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Downloaded third-party datasets (IMDb licence forbids redistribution)
pipeline/.cache/

# Rejected or half-written pipeline output (accepted candidates are committed via review PRs)
pipeline/candidates/*.failed.json
pipeline/candidates/*.part

# Secrets: NEVER commit real values. Commit .env.example instead.
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
